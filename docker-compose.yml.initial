services:
  control-horas:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: control-horas-app
    # Si se usará traefik, cloudlfared tunnel o algún otro reverse proxy (RP) eliminar el puerto.
    ports:
      - "3001:3001"
    env_file:
      - .env
    environment:
      - NODE_ENV=production
    volumes:
      - ./server:/app/server
      - ./server/.env:/app/server/.env:ro
      - ./public:/app/public:ro
    restart: unless-stopped
    networks:
      - control-horas-network #O red del RP
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:3001"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
      user: "1000:1000"

#Uso con puerto expuesto
networks:
  control-horas-network:
    driver: bridge
    
#Uso RP
networks:
  proxy: #Red del RP
    external: true
